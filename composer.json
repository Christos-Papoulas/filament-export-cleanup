{
    "name": "pachristos/filament-export-cleanup",
    "description": "Clean up old Filament export files and database records.",
    "keywords": [
        "filament",
        "filamentphp",
        "laravel",
        "export",
        "cleanup"
    ],
    "homepage": "https://github.com/Christos-Papoulas/filament-export-cleanup",
    "license": "MIT",
    "authors": [
        {
            "name": "Christos Papoulas",
            "email": "pachristos@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/actions": "^4.0|^5.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Pachristos\\FilamentExportCleanup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pachristos\\FilamentExportCleanup\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pachristos\\FilamentExportCleanup\\FilamentExportCleanupServiceProvider"
            ],
            "aliases": {
                "FilamentExportCleanup": "Pachristos\\FilamentExportCleanup\\Facades\\FilamentExportCleanup"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
